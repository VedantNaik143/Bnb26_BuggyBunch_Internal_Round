# Roundtable Environment Configuration

# Gemini API Key (Required for live Gemini transcription)
# Set your key here or via backend environment.
# If omitted, system seamlessly runs in local acoustic VAD transcription mode.
GEMINI_API_KEY=""

# Gemini Live Model
GEMINI_MODEL="gemini-2.0-flash"

# Backend Server Configuration
HOST="0.0.0.0"
PORT=8000

# Public or local network URL for multi-device sharing (e.g., http://192.168.1.50:3000)
APP_URL="http://localhost:3000"
